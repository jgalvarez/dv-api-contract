  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "The organization's API key. Keep it on your servers; never send it to a browser or an app."
      }
    },
    "parameters": {
      "InquiryId": {
        "name": "inquiry_id",
        "in": "path",
        "required": true,
        "description": "The case id: `case_id` from creating a case, or `inquiry_id` from the case list.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "OrgId": {
        "name": "org_id",
        "in": "path",
        "required": true,
        "description": "Your organization's id, given with your API key. It must be the key's own organization.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "OrgSelection": {
        "name": "X-DigaVouch-Org",
        "in": "header",
        "required": false,
        "description": "Optional. An organization id; with an API key it may only repeat the key's own organization. Send it if you want a request refused, rather than answered, when it would act for an organization other than the one you meant.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "IntakeApplicationRequest": {
        "type": "object",
        "properties": {
          "application_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "The application's id in your system: required, not blank, at most 200 characters after trimming. It is the key that makes a retry safe, so it must never change and never be reused for another application."
          },
          "job_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "The job posting's id in your system, with the same limits. Use an id that stays the same for the life of the posting (a database row id, not an editable slug): the organization maps it to what the applicant is asked to verify."
          },
          "job_title": {
            "type": "string",
            "description": "Optional. Used only to label a job the organization has not mapped yet."
          },
          "candidate": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Optional. Used to greet the applicant."
              },
              "email": {
                "type": "string",
                "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
                "description": "Required. Where the applicant is invited, unless the organization takes the link in the response instead."
              }
            },
            "required": [
              "email"
            ],
            "additionalProperties": true
          }
        },
        "required": [
          "application_id",
          "job_id",
          "candidate"
        ],
        "additionalProperties": true,
        "description": "One application from your system. Fields not listed here are ignored and not stored; do not send more than this. The organization comes from the API key, never from the body."
      },
      "IntakeApplicationResponse": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "description": "The case id. Use it to read the result and to issue a fresh applicant link."
          },
          "outcome": {
            "type": "string",
            "enum": [
              "created",
              "existing"
            ],
            "description": "`created`: a new case (201). `existing`: this application id already has a case for this email address (200); nothing new was created and no second invite was sent."
          },
          "verification_link": {
            "type": "string",
            "description": "The applicant's link, on a 201 only, and only when the organization takes the link in the response instead of, or as well as, an email. It is a credential to the applicant's session: give it only to the applicant, and do not log or store it."
          },
          "verification_link_expires_at": {
            "type": "string",
            "description": "When the link expires (ISO 8601). Sent with `verification_link`."
          }
        },
        "required": [
          "case_id",
          "outcome"
        ],
        "additionalProperties": true,
        "description": "The case this application created or already had."
      },
      "InquiryResultResponse": {
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "string",
            "pattern": "^1\\.\\d+\\.\\d+$",
            "description": "The result contract version this response follows. MINOR adds a field (ignore fields you do not know); MAJOR removes, renames or changes one."
          },
          "inquiry_id": {
            "type": "string",
            "description": "The case id."
          },
          "applicant": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "email_domain": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The domain of the verified email address, once one is verified."
              }
            },
            "required": [
              "name",
              "email_domain"
            ],
            "additionalProperties": true
          },
          "signals_summary": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResultSignal"
            }
          },
          "verification_progress": {
            "type": "object",
            "properties": {
              "current_step": {
                "type": "number"
              },
              "steps_completed": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "steps_total": {
                "type": "number"
              },
              "percent_complete": {
                "type": "number"
              }
            },
            "required": [
              "steps_completed",
              "steps_total",
              "percent_complete"
            ],
            "additionalProperties": true,
            "description": "How far the applicant is through their steps. All zero before the applicant has a link."
          },
          "submitted_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "When the applicant submitted. null until then."
          },
          "decided_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "When the organization's reviewer recorded a decision. null until then."
          },
          "operator_action": {
            "type": [
              "string",
              "null"
            ],
            "description": "The organization's reviewer decision: `approved`, `denied`, `escalated` or `requested_more_info`. null until one is recorded."
          },
          "vouchers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResultVoucher"
            }
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResultEvent"
            }
          }
        },
        "required": [
          "schema_version",
          "inquiry_id",
          "applicant",
          "signals_summary",
          "verification_progress",
          "submitted_at",
          "decided_at",
          "operator_action",
          "vouchers",
          "events"
        ],
        "additionalProperties": true,
        "description": "The facts of one case: what was verified, what is pending, who vouched and what they said, and what happened when. No score, zone, recommendation, per-item confidence or score breakdown, under this contract version or any 1.x. A response may carry older fields this schema does not declare (`applicant.dob`, `applicant.property`, `vouchers[].voucher_email`); they are not part of the contract and may disappear in a MAJOR version."
      },
      "ResultSignal": {
        "$ref": "#/components/schemas/InquiryResultResponse/properties/signals_summary/items"
      },
      "ResultVoucher": {
        "$ref": "#/components/schemas/InquiryResultResponse/properties/vouchers/items"
      },
      "ResultEvent": {
        "$ref": "#/components/schemas/InquiryResultResponse/properties/events/items"
      },
      "InquirySessionResponse": {
        "type": "object",
        "properties": {
          "verification_link": {
            "type": "string",
            "description": "A new link for the applicant, valid for 72 hours. No email is sent: deliver it yourself. It is a credential to the applicant's session: give it only to the applicant, and do not log or store it."
          },
          "inquiry_id": {
            "type": "string",
            "description": "The case id."
          },
          "org_id": {
            "type": "string",
            "description": "The organization's id."
          }
        },
        "required": [
          "verification_link",
          "inquiry_id",
          "org_id"
        ],
        "additionalProperties": true,
        "description": "A fresh applicant link. The response also carries `session_token`, the token at the end of the link; it is not part of the contract and may disappear in a MAJOR version."
      },
      "InquiryListResponse": {
        "type": "object",
        "properties": {
          "inquiries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InquiryListItem"
            },
            "description": "Every case the organization has not deleted, newest first. There is no paging."
          },
          "total": {
            "type": "number",
            "description": "The number of cases in `inquiries`."
          }
        },
        "required": [
          "inquiries",
          "total"
        ],
        "additionalProperties": true,
        "description": "The organization's cases."
      },
      "InquiryListItem": {
        "$ref": "#/components/schemas/InquiryListResponse/properties/inquiries/items"
      },
      "PartnerError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "ORG_SELECTION_INVALID",
              "INVALID_AUTH",
              "API_KEY_REQUIRED",
              "FORBIDDEN",
              "ORG_MISMATCH",
              "ORG_SELECTION_FORBIDDEN",
              "NOT_FOUND",
              "INQUIRY_NOT_FOUND",
              "INQUIRY_DECIDED",
              "APPLICATION_EMAIL_MISMATCH",
              "CASE_DELETED",
              "UNMAPPED_JOB",
              "RATE_LIMIT_EXCEEDED",
              "NO_DEFAULT_CAMPAIGN",
              "INTERNAL_ERROR"
            ],
            "description": "For machines; a code never changes meaning. The list is closed, and adding a code is a new contract package version: branch on the HTTP status first and the code second, and treat an unknown code by its status. FORBIDDEN and ORG_MISMATCH mean the same thing, as do NOT_FOUND and INQUIRY_NOT_FOUND; both of each pair stay because existing callers receive them."
          },
          "message": {
            "type": "string",
            "description": "For people. May be reworded. Never contains the applicant's or a voucher's personal data, so it is safe to log or pass on."
          },
          "field": {
            "type": "string",
            "description": "On INVALID_REQUEST, the field that is missing or invalid, as a dotted path, when known."
          },
          "retry_after_seconds": {
            "type": "number",
            "description": "On a 429 only: how many seconds to wait before retrying."
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": true,
        "description": "The error body of every partner route. Retry rule: retry a 429 after `retry_after_seconds`, and INTERNAL_ERROR with the same request a few times with backoff; never retry any other code unchanged. Some responses also carry older fields (`error`, `statusCode`) kept for existing callers; they are not part of the contract."
      }
    }
  }
}
