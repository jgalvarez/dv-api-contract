                      "properties": {
                        "code": {
                          "enum": [
                            "INVALID_AUTH"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "The case belongs to another organization (ORG_MISMATCH), or the `X-DigaVouch-Org` header names an organization this key is not for (ORG_SELECTION_FORBIDDEN).",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/PartnerError"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "ORG_MISMATCH",
                            "ORG_SELECTION_FORBIDDEN"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
