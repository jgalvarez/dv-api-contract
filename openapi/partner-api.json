    "/digavouch/v1/inquiries/{inquiry_id}/session": {
      "post": {
        "operationId": "createApplicantLink",
        "summary": "Issue a fresh applicant link",
        "tags": [
          "Cases"
        ],
        "description": "A new link for the applicant of an existing case, for example when the first one expired or never arrived. No email is sent: deliver the link yourself. Earlier links are not revoked; each stays valid until it expires. Send no body.",
        "parameters": [
          {
            "$ref": "#/components/parameters/InquiryId"
          },
          {
            "$ref": "#/components/parameters/OrgSelection"
          }
        ],
        "responses": {
          "201": {
            "description": "The new link.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InquirySessionResponse"
                }
              }
            }
          },
          "400": {
            "description": "The `X-DigaVouch-Org` header is present but is not an organization id (ORG_SELECTION_INVALID).",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/PartnerError"
                    },
                    {
                      "properties": {
                        "code": {
                          "enum": [
                            "ORG_SELECTION_INVALID"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "No `X-API-Key` header, or the key is not valid.",
